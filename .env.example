# Anthropic API key for the Claude Agent SDK (required to run the CLI agent)
ANTHROPIC_API_KEY=

# Alchemy API key for EVM RPC (optional - falls back to public RPC if unset)
ALCHEMY_API_KEY=

# Helius API key for Solana RPC (optional - falls back to public RPC if unset)
HELIUS_API_KEY=

# CoinGecko API key for price data (optional - public tier used if unset)
COINGECKO_API_KEY=
