# Anthropic API key for the Claude Agent SDK (required to run the CLI agent)
ANTHROPIC_API_KEY=

# Alchemy API key for EVM RPC (optional - falls back to public RPC if unset)
ALCHEMY_API_KEY=

# Helius API key for Solana RPC (optional - falls back to public RPC if unset)
HELIUS_API_KEY=

# CoinGecko API key for price data (optional - public tier used if unset)
COINGECKO_API_KEY=

# Cloud SQL / PostgreSQL cache (decision #70 — production)
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/coinwatch
# COINWATCH_ENV=production
# COINWATCH_DB_PATH=coinwatch.db

# Optional provider endpoint overrides (decision #69 — private/self-hosted RPC)
# MEMPOOL_API_BASE=https://mempool.space/api
# SOLANA_RPC_URL=
# EVM_RPC_ETHEREUM=
# EVM_RPC_BASE=
# EVM_RPC_POLYGON=
# EVM_RPC_ARBITRUM=
# EVM_RPC_OPTIMISM=
