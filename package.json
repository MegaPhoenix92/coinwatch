{
  "name": "coinwatch",
  "version": "0.1.0",
  "private": true,
  "description": "Watch-only multi-chain crypto CLI. Holds no private keys, never signs.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MegaPhoenix92/coinwatch.git"
  },
  "bin": {
    "coinwatch": "./dist/cli.js"
  },
  "files": [
    "dist",
    "config/accounts.example.json",
    "CHANGELOG.md",
    "RELEASING.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "release:verify": "node scripts/verify-release-artifact.mjs",
    "registry:verify": "node scripts/verify-registry.mjs",
    "security:no-signing": "node scripts/check-no-signing.mjs src",
    "security:secrets": "node scripts/check-secrets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.158",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "@scure/bip32": "^2.2.0",
    "@scure/btc-signer": "^2.2.0",
    "@solana-program/system": "^0.12.2",
    "@solana-program/token": "^0.13.0",
    "@solana-program/token-2022": "^0.9.0",
    "@solana/kit": "^6.9.0",
    "better-sqlite3": "^12.10.0",
    "pg": "^8.16.0",
    "viem": "^2.51.3",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.15.4",
    "@types/node": "^22",
    "tsx": "^4.22.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "@solana-program/token-2022": {
      "@solana/sysvars": "6.9.0"
    }
  }
}
